# BeautyBook environment template.
# Copy this file to `.env` and replace every placeholder. `.env` must never be committed.

APP_ENV=development

# PostgreSQL connection used by the application.
DATABASE_URL=postgresql+psycopg://beautybook_app:CHANGE_ME@127.0.0.1:5432/beautybook

# Separate database for integration tests.
TEST_DATABASE_URL=postgresql+psycopg://beautybook_app:CHANGE_ME@127.0.0.1:5432/beautybook_test

# Sessions (absolute lifetime in days).
SESSION_TTL_DAYS=7
# Leave unset to derive from APP_ENV. Explicit true/false overrides the derivation.
SESSION_COOKIE_SECURE=false

# Cookie and header names. The defaults match the specification.
SESSION_COOKIE_NAME=beautybook_session
CSRF_COOKIE_NAME=beautybook_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# Argon2id parameters. The defaults are the production minimum.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Frontend API base path. Development uses the Vite proxy, so a relative path is enough.
VITE_API_BASE_URL=/api/v1

# Only needed when PostgreSQL runs through `infra/compose.yaml`.
POSTGRES_PASSWORD=CHANGE_ME
